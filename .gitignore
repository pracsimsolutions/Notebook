# OS
Thumbs.db
Desktop.ini
.DS_Store

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# FlexSim
# (working/backup files emitted next to .fsm during a session)
*.fsm.bak
*.fsm.lock
*.fsm.tmp

# Build artifacts — contributors build these locally.
# Notebook.dll is produced by Visual Studio building NotebookDLL.sln.
# Notebook.t is regenerated by FlexSim on Save Defaults from the .fsx.
Notebook.dll
Notebook.t
Notebook.lib
Notebook.exp
Notebook.pdb
Notebook.iobj
Notebook.ipdb

# Superpowers brainstorming companion (mockups, session state)
.superpowers/

# Internal design docs / session artifacts — kept locally, not published
docs/

# NotebookDLL build artifacts. msbuild nests intermediate files under
# NotebookDLL/NotebookDLL/x64/ (project-name subdir for tlog/obj) while
# the final DLL ends up at NotebookDLL/x64/Release/ — the ** glob
# catches both.
NotebookDLL/flexsimcontent/
NotebookDLL/**/x64/
NotebookDLL/.vs/
NotebookDLL/*.user
